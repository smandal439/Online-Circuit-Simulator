{
  "id": "l298n_dc_motor",
  "name": "L298N Dual DC Motor Control",
  "icon": "🔌",
  "desc": "Control two DC motors with L298N H-bridge driver — direction and PWM speed",
  "tags": ["motor", "l298n", "actuator", "pwm"],
  "code": "int in1 = 8;\nint in2 = 9;\nint ena = 10;\nint in3 = 12;\nint in4 = 13;\nint enb = 11;\n\nvoid setup() {\n  pinMode(in1, OUTPUT);\n  pinMode(in2, OUTPUT);\n  pinMode(in3, OUTPUT);\n  pinMode(in4, OUTPUT);\n  pinMode(ena, OUTPUT);\n  pinMode(enb, OUTPUT);\n}\n\nvoid loop() {\n  // Motor A forward\n  digitalWrite(in1, HIGH);\n  digitalWrite(in2, LOW);\n  analogWrite(ena, 200);\n\n  // Motor B reverse\n  digitalWrite(in3, LOW);\n  digitalWrite(in4, HIGH);\n  analogWrite(enb, 150);\n  delay(2000);\n\n  // Stop both\n  digitalWrite(in1, LOW);\n  digitalWrite(in2, LOW);\n  digitalWrite(in3, LOW);\n  digitalWrite(in4, LOW);\n  delay(1000);\n}",
