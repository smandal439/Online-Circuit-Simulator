{
  "id": "lm35_temperature",
  "name": "LM35 Temperature Sensor",
  "icon": "🌡️",
  "desc": "Read temperature from LM35 sensor and display in Celsius & Fahrenheit",
  "tags": [
    "beginner",
    "sensor",
    "lm35",
    "temperature"
  ],
  "code": "const int sensorPin = A5;\r\n\r\nvoid setup() {\r\n  Serial.begin(115200);\r\n}\r\n\r\nvoid loop() {\r\n  int sensorValue = analogRead(sensorPin);\r\n  \r\n  float temperatureCelsius = (sensorValue * 500.0) / 1023.0;\r\n  float temperatureFahrenheit = (temperatureCelsius * 1.8) + 32.0;\r\n\r\n  Serial.print(\"Temperature: \");\r\n  Serial.print(temperatureCelsius);\r\n  Serial.print(\" °C  |  \");\r\n  Serial.print(temperatureFahrenheit);\r\n  Serial.println(\" °F\");\r\n\r\n  delay(1000);\r\n}",
