{
  "id": "opamp_741_non_inverting",
  "name": "LM741 Non-Inverting Amplifier",
  "icon": "📐",
  "desc": "Non-inverting amplifier using an LM741 op-amp — gain (1 + R2/R1) with a potentiometer input, feedback network, LED output and DSO visualization",
  "tags": [
    "op-amp",
    "LM741",
    "operational amplifier",
    "analog",
    "amplifier",
    "non-inverting"
  ],
  "circuit": {
    "components": [
      { "id": "pot1", "type": "potentiometer", "x": 60,  "y": 230, "props": { "value": 300 } },
      { "id": "u1",   "type": "lm741",        "x": 330, "y": 200 },
      { "id": "r1",   "type": "resistor",     "x": 330, "y": 330, "props": { "value": 10000 } },
      { "id": "r2",   "type": "resistor",     "x": 520, "y": 210, "props": { "value": 10000 } },
      { "id": "r_led","type": "resistor",     "x": 610, "y": 240, "props": { "value": 220 } },
      { "id": "led1", "type": "led",          "x": 690, "y": 210, "props": { "color": "#ff3333", "colorName": "Red" } },
      { "id": "p5v",  "type": "power_5v",     "x": 300, "y": 150 },
      { "id": "gnd",  "type": "power_gnd",    "x": 180, "y": 390 },
      { "id": "gnd2", "type": "power_gnd",    "x": 30,  "y": 330 },
      { "id": "dso",  "type": "dso_4ch",      "x": 60,  "y": 480 }
    ],
    "wires": [
      { "id": "w1",
        "from": { "instId": "pot1", "pinId": "wiper" },
        "to":   { "instId": "u1",   "pinId": "INP" } },
      { "id": "w1a",
        "from": { "instId": "pot1", "pinId": "vcc" },
        "to":   { "instId": "p5v",  "pinId": "vcc" } },
      { "id": "w1b",
        "from": { "instId": "pot1", "pinId": "gnd" },
        "to":   { "instId": "gnd2", "pinId": "gnd" } },
      { "id": "w2",
        "from": { "instId": "u1",   "pinId": "INN" },
        "to":   { "instId": "r1",   "pinId": "p1" } },
      { "id": "w3",
        "from": { "instId": "r1",   "pinId": "p2" },
        "to":   { "instId": "gnd",  "pinId": "gnd" } },
      { "id": "w4",
        "from": { "instId": "u1",   "pinId": "OUT" },
        "to":   { "instId": "r2",   "pinId": "p1" } },
      { "id": "w5",
        "from": { "instId": "r2",   "pinId": "p2" },
        "to":   { "instId": "u1",   "pinId": "INN" } },
      { "id": "w6",
        "from": { "instId": "u1",   "pinId": "OUT" },
        "to":   { "instId": "r_led","pinId": "p1" } },
      { "id": "w7",
        "from": { "instId": "r_led","pinId": "p2" },
        "to":   { "instId": "led1", "pinId": "anode" },
        "waypoints": [ { "x": 705, "y": 300 } ] },
      { "id": "w8",
        "from": { "instId": "led1", "pinId": "cathode" },
        "to":   { "instId": "gnd",  "pinId": "gnd" } },
      { "id": "w9",
        "from": { "instId": "u1",   "pinId": "VCCP" },
        "to":   { "instId": "p5v",  "pinId": "vcc" } },
      { "id": "w10",
        "from": { "instId": "u1",   "pinId": "VCCN" },
        "to":   { "instId": "gnd",  "pinId": "gnd" } },
      { "id": "w11",
        "from": { "instId": "u1",   "pinId": "OUT" },
        "to":   { "instId": "dso",  "pinId": "ch1_in" },
        "waypoints": [ { "x": 500, "y": 200 }, { "x": 500, "y": 760 }, { "x": 110, "y": 760 } ] },
      { "id": "w12",
        "from": { "instId": "gnd",  "pinId": "gnd" },
        "to":   { "instId": "dso",  "pinId": "gnd" },
        "waypoints": [ { "x": 180, "y": 780 }, { "x": 410, "y": 780 } ] }
    ]
  },
  "code": "/*\n * LM741 Non-Inverting Amplifier\n *\n * Gain = 1 + (R2 / R1) = 1 + (10k / 10k) = 2\n *\n * Signal path:\n *   Potentiometer VCC  →  +5V\n *   Potentiometer GND  →  GND\n *   Potentiometer wiper →  LM741 non-inverting input (+) pin 3\n *   R1 (10k) connects inverting input (-) pin 2 to GND\n *   R2 (10k) provides negative feedback from OUT (pin 6) to IN(-) pin 2\n *   Output drives an LED (through a 220 ohm current-limiting resistor)\n *   Output is also shown on DSO channel 1\n *\n * Adjust the potentiometer to change the DC input level and watch the\n * op-amp buffer/amplify it on the LED and DSO. With a gain of 2 the\n * output will quickly hit the +5V rail for mid/high input levels.\n */\n\nvoid setup() {\n  Serial.println(\"LM741 Non-Inverting Amplifier\");\n  Serial.println(\"Gain = 1 + R2/R1 = 2\");\n}\n\nvoid loop() {\n  delay(1000);\n}"
}
