{
  "id": "neopixel_strip_chase",
  "name": "NeoPixel Strip Color Chase",
  "icon": "🌈",
  "desc": "Two daisy-chained NeoPixel strips with red, white, and green chase animation",
  "tags": ["led", "neopixel", "animation"],
  "code": "#include <Adafruit_NeoPixel.h>\n\n#define PIN        6\n#define NUM_LEDS   16\n\nAdafruit_NeoPixel strip(NUM_LEDS, PIN, NEO_GRB + NEO_KHZ800);\n\nvoid setup() {\n  strip.begin();\n  strip.setBrightness(255);\n  strip.show();\n}\n\nvoid loop() {\n  // Red chase\n  for (int i = 0; i < NUM_LEDS; i++) {\n    strip.setPixelColor(i, strip.Color(255, 0, 0));\n    strip.show();\n    delay(200);\n    strip.setPixelColor(i, strip.Color(0, 0, 0));\n  }\n  // White chase\n  for (int i = 0; i < NUM_LEDS; i++) {\n    strip.setPixelColor(i, strip.Color(150, 150, 150));\n    strip.show();\n    delay(200);\n    strip.setPixelColor(i, strip.Color(0, 0, 0));\n  }\n  // Green chase\n  for (int i = 0; i < NUM_LEDS; i++) {\n    strip.setPixelColor(i, strip.Color(0, 255, 0));\n    strip.show();\n    delay(200);\n    strip.setPixelColor(i, strip.Color(0, 0, 0));\n  }\n}",
